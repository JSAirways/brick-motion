{
  "name": "brick-motion",
  "version": "1.0.1",
  "description": "Desktop stop-motion app built with Electron and TypeScript.",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "sync:app-version": "node scripts/sync-app-version.cjs",
    "predev": "npm run sync:app-version",
    "prebuild": "npm run sync:app-version",
    "dev": "concurrently -k \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "vite",
    "dev:electron": "wait-on tcp:5173 && npm run build:electron && cross-env ELECTRON_START_URL=http://localhost:5173 electron .",
    "build": "npm run build:renderer && npm run build:electron",
    "build:renderer": "vite build",
    "build:electron": "node -e \"require('node:fs').rmSync('dist-electron',{recursive:true,force:true})\" && tsc -p tsconfig.electron.json",
    "build:native": "node scripts/native-build.cjs",
    "build:native:gyp-rebuild": "node-gyp rebuild --directory native/camera-mf",
    "build:native:incremental": "node-gyp configure build --directory native/camera-mf",
    "rebuild:native": "electron-rebuild -f -w camera_mf -d ./native/camera-mf",
    "preview": "vite preview",
    "start": "electron .",
    "dist:win": "npm run rebuild:native && npm run build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win nsis"
  },
  "keywords": [
    "electron",
    "stop-motion",
    "typescript"
  ],
  "author": {
    "name": "Jonan Steiner",
    "email": "jonan.steiner@gmail.com",
    "url": "https://jonan.space"
  },
  "homepage": "https://jonan.space",
  "repository": {
    "type": "git",
    "url": "https://github.com/JSAirways/brick-motion.git"
  },
  "bugs": {
    "url": "https://github.com/JSAirways/brick-motion/issues"
  },
  "license": "MIT",
  "dependencies": {
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.1"
  },
  "devDependencies": {
    "@types/node": "^24.6.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^37.6.0",
    "electron-builder": "^24.13.3",
    "electron-rebuild": "^3.2.9",
    "node-gyp": "^12.2.0",
    "sass": "^1.93.2",
    "typescript": "^5.9.3",
    "vite": "^6.0.0",
    "wait-on": "^8.0.5"
  },
  "build": {
    "appId": "space.jonan.brickmotion",
    "productName": "Brick-Motion",
    "artifactName": "${productName}-Setup-${version}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist-electron/**/*",
      "dist-renderer/**/*",
      "public/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "native/camera-mf/build/Release/",
        "to": "native/camera-mf/build/Release",
        "filter": [
          "*.node"
        ]
      }
    ],
    "win": {
      "icon": "public/assets/logo.ico",
      "signAndEditExecutable": true,
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "installerIcon": "public/assets/logo.ico",
      "uninstallerIcon": "public/assets/logo.ico",
      "installerHeaderIcon": "public/assets/logo.ico",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Brick-Motion",
      "uninstallDisplayName": "Brick-Motion"
    }
  }
}
